# surelay VLESS+Reality 示例配置
# 使用方法：cp config.example.env config.env && nano config.env
# 不要把 config.env、home-proxies.csv、upstream-nodes.txt、Reality 私钥、UUID、节点输出文件提交到公开仓库。

SERVER_ALIAS="my-vps"
SERVER_IP=""
SERVER_IP_IPV4=""
SERVER_IP_IPV6=""
# 本机 sshd 监听端口；NAT 公网 SSH 端口不同也不要填到这里。
SSH_PORT="22"
INITIAL_USER="root"
ADMIN_USER="root"
ADMIN_PUBKEY=""
# 可选：分步骤运行时如需多个 root 公钥，也可以把额外公钥逐行写入 ADMIN_PUBKEYS。
# 示例：ADMIN_PUBKEYS=$'ssh-ed25519 AAAA... user1\nssh-ed25519 BBBB... user2'
ADMIN_PUBKEYS=""
ENABLE_SFTP_USER="false"
SFTP_USER="sftpuser"
USE_233BOY_INSTALLER="false"
# auto: Debian/Ubuntu 使用 APT；Alpine 3.19 使用校验摘要的官方固定版本。
INSTALL_SINGBOX_METHOD="auto"
MODE_443="direct"
# 主入口监听端口与客户端节点端口。NAT 同号映射可改为分配的业务端口。
DIRECT_PORT="443"
HOME_PORT_START="51043"
HOME_PORT_END="65535"
ENABLE_UFW="true"
ENABLE_FAIL2BAN="true"
# Alpine 文件日志 jail；必须能收到 sshd/authpriv 日志。Debian/Ubuntu 使用 journal。
FAIL2BAN_SSH_LOG="/var/log/messages"
ENABLE_IPV6_LISTEN="false"

# 额外可选项；默认安全保守。
SFTP_PUBKEY=""
CSV_PATH="./home-proxies.csv"
UPSTREAM_NODES_PATH="./upstream-nodes.txt"
RRB_STATE_DIR="/etc/surelay"
SINGBOX_CONFIG_PATH="/etc/sing-box/config.json"

# 可选：自有域名，默认假设 DNS 托管在 Cloudflare 且记录为灰云 / DNS only。
# 启用后 DIRECT_PORT 由 sing-box 监听；普通 TLS fallback 到本机 Nginx 8443。
ENABLE_CUSTOM_DOMAIN="false"
CUSTOM_DOMAIN=""
CUSTOM_DOMAIN_PROVIDER="cloudflare"
LE_EMAIL=""
LE_STAGING="false"
# 一键脚本会把 token 写入 600 权限 credentials 文件；手动部署也可直接准备 CLOUDFLARE_API_TOKEN_FILE。
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_API_TOKEN_FILE="/etc/surelay/cloudflare.ini"
CLOUDFLARE_ZONE_NAME=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_CREATE_ZONE="false"
CLOUDFLARE_ENSURE_DNS_RECORDS="true"
CLOUDFLARE_DNS_OVERWRITE_EXISTING="true"
CLOUDFLARE_REQUIRE_ACTIVE_ZONE="true"
CLOUDFLARE_DNS_TTL="1"
CLOUDFLARE_DNS_PROPAGATION_SECONDS="60"
NGINX_FALLBACK_HOST="127.0.0.1"
NGINX_FALLBACK_PORT="8443"
NGINX_FALLBACK_ROOT="/var/www/surelay-fallback"
# auto: Debian/Ubuntu sites-available；Alpine http.d。
NGINX_FALLBACK_CONF="auto"

# 入站协议固定为 VLESS + Reality。
PROXY_PROTOCOL="vless-reality"
# 代理出站/DNS IP 版本：ipv4、ipv6、dual。默认 ipv4；dual 表示双栈并优先 IPv4。
PROXY_IP_VERSION="ipv4"
# true 会重新生成 VLESS UUID、Reality keypair 和 short-id；默认 false，修改家宽/上游落地节点时不会让旧节点失效。
RESET_PROXY_KEYS="false"
VLESS_UUID_PATH="/etc/surelay/vless-uuid.txt"
VLESS_FLOW="xtls-rprx-vision"
REALITY_PRIVATE_KEY_PATH="/etc/surelay/reality-private.key"
REALITY_PUBLIC_KEY_PATH="/etc/surelay/reality-public.key"
REALITY_SHORT_ID_PATH="/etc/surelay/reality-short-id.txt"
REALITY_SERVER_NAME="www.microsoft.com"
REALITY_HANDSHAKE_SERVER="www.microsoft.com"
REALITY_HANDSHAKE_PORT="443"
REALITY_MAX_TIME_DIFFERENCE="1m"

# 客户端节点输出参数。
CLIENT_FINGERPRINT="chrome"
CLIENT_UDP="true"
CLIENT_ALPN="h2,http/1.1"
CLASH_MIXED_PORT="7890"

# 可选订阅服务。内置 HTTP 文件服务使用 VLESS UUID 作为订阅 token。
ENABLE_SUBSCRIPTION_SERVER="true"
# 自有域名模式下 SUBSCRIPTION_PORT 可留空，订阅经 DIRECT_PORT 的 HTTPS fallback。
# 填写 SUBSCRIPTION_PORT 时才额外开放并显示 http://SERVER_IP:SUBSCRIPTION_PORT/sub/...。
# 未启用自有域名时留空会回退为 SUBSCRIPTION_INTERNAL_PORT。
SUBSCRIPTION_PORT=""
SUBSCRIPTION_INTERNAL_PORT="51040"
# 当前只生成 ClashMeta/Mihomo YAML 订阅；旧 target 会按 ClashMeta 处理。
SUBSCRIPTION_TARGET="ClashMeta"
# 留空时自有域名模式自动使用 https://CUSTOM_DOMAIN[:DIRECT_PORT]（443 省略）。
# 可选：反代后的外部地址，仅用于输出订阅链接，例如 https://sub.example.com。
SUBSCRIPTION_BASE_URL=""
SUBSCRIPTION_DIR="/etc/surelay/subscription"
