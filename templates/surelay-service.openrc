#!/sbin/openrc-run
# Managed by surelay. Arguments are in /etc/conf.d/$RC_SVCNAME.
description="SuRelay: ${RC_SVCNAME}"
supervisor="supervise-daemon"
pidfile="/run/${RC_SVCNAME}.pid"
respawn_delay=3
respawn_max=5
respawn_period=60
output_log="/var/log/surelay/${RC_SVCNAME}.log"
error_log="$output_log"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath --directory --mode 0700 /var/log/surelay || return 1
    checkpath --file --mode 0600 "$output_log" || return 1
    if [ -n "${rrb_check_config:-}" ]; then
        "$command" check -c "$rrb_check_config" || return 1
    fi
}
